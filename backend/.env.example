PORT=4500
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
MONGODB_URI=mongodb://127.0.0.1:27017/electrastore
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
JWT_SECRET=replace-with-a-long-random-secret
TRUST_PROXY_HOPS=1
API_RATE_LIMIT=500
AUTH_RATE_LIMIT=100
ASSISTANT_RATE_LIMIT=20
REDIS_URL=
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ElectraStore
OPENROUTER_CHAT_TIMEOUT_MS=25000
OPENROUTER_EMBEDDING_TIMEOUT_MS=15000
OPENROUTER_WEB_SEARCH_ENABLED=false
OPENROUTER_WEB_SEARCH_ENGINE=auto
OPENROUTER_WEB_SEARCH_MAX_RESULTS=3
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=10000
RAG_EMBEDDING_BATCH_SIZE=4
RAG_EMBEDDING_RETRIES=2
CLOUDINARY_NAME=replace-with-your-cloudinary-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="ElectraStore <no-reply@example.com>"
CLIENT_APP_URL=http://localhost:3000
