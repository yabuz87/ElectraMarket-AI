PORT=4500
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
MONGODB_URI=mongodb://127.0.0.1:27017/electrastore
JWT_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ElectraStore
CLOUDINARY_NAME=replace-with-your-cloudinary-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="ElectraStore <no-reply@example.com>"
CLIENT_APP_URL=http://localhost:3000
